<?xml version="1.0" encoding="utf-8"?>
<!--
  Pengganti service.sh milik modul KSU:
  izin runtime diberikan otomatis saat first boot, tanpa `pm grant` manual.
-->
<exceptions>
    <exception package="com.android.camera">
        <permission name="android.permission.CAMERA" fixed="false"/>
        <permission name="android.permission.RECORD_AUDIO" fixed="false"/>
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false"/>
        <permission name="android.permission.ACCESS_MEDIA_LOCATION" fixed="false"/>
        <permission name="android.permission.READ_MEDIA_IMAGES" fixed="false"/>
        <permission name="android.permission.READ_MEDIA_VIDEO" fixed="false"/>
        <permission name="android.permission.READ_MEDIA_AUDIO" fixed="false"/>
        <permission name="android.permission.WRITE_MEDIA_IMAGES" fixed="false"/>
        <permission name="android.permission.WRITE_MEDIA_VIDEO" fixed="false"/>
    </exception>
    <exception package="com.miui.extraphoto">
        <permission name="android.permission.ACCESS_MEDIA_LOCATION" fixed="false"/>
        <permission name="android.permission.READ_MEDIA_IMAGES" fixed="false"/>
        <permission name="android.permission.READ_MEDIA_VIDEO" fixed="false"/>
        <permission name="android.permission.WRITE_MEDIA_IMAGES" fixed="false"/>
        <permission name="android.permission.WRITE_MEDIA_VIDEO" fixed="false"/>
    </exception>
</exceptions>
